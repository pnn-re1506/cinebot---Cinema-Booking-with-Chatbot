  "ticketAssignmentCases": [
    { "id": "TA-01", "description": "Sorted by row then number; first N singles are students (BR-06)", "seats": [{ "label": "B5", "seatType": "SINGLE" }, { "label": "A7", "seatType": "SINGLE" }, { "label": "A6", "seatType": "SINGLE" }], "quantities": { "adult": 2, "student": 1, "couple": 0 }, "expected": [{ "label": "A6", "ticketType": "STUDENT" }, { "label": "A7", "ticketType": "ADULT" }, { "label": "B5", "ticketType": "ADULT" }] },
    { "id": "TA-02", "description": "Seat numbers sort numerically (A9 before A10)", "seats": [{ "label": "A10", "seatType": "SINGLE" }, { "label": "A9", "seatType": "SINGLE" }], "quantities": { "adult": 1, "student": 1, "couple": 0 }, "expected": [{ "label": "A9", "ticketType": "STUDENT" }, { "label": "A10", "ticketType": "ADULT" }] },
    { "id": "TA-03", "description": "Couple seats are always COUPLE", "seats": [{ "label": "K2", "seatType": "COUPLE" }, { "label": "C4", "seatType": "SINGLE" }, { "label": "C3", "seatType": "SINGLE" }], "quantities": { "adult": 0, "student": 2, "couple": 1 }, "expected": [{ "label": "C3", "ticketType": "STUDENT" }, { "label": "C4", "ticketType": "STUDENT" }, { "label": "K2", "ticketType": "COUPLE" }] },
