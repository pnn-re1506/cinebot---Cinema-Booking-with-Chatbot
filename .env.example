# PostgreSQL (ARCHITECTURE §12)
DB_URL=jdbc:postgresql://localhost:5432/cinebot
DB_USER=cinebot
DB_PASSWORD=cinebot

# Redis. Use rediss:// for TLS hosts such as Upstash.
REDIS_URL=redis://localhost:6379

# HS256 key, at least 32 bytes. Replace before any shared deployment.
JWT_SECRET=change-me-to-a-random-string-at-least-32-bytes

# Frontend origin (CORS, refresh-cookie Origin allow-list) and public API URL.
APP_PUBLIC_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:8080

# VNPay sandbox. Leave the secrets empty until the owner creates an account.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
PAYMENT_PROVIDERS_ENABLED=MOCK

# SMTP. Local default is a capture server such as Mailpit on port 1025.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@cinebot.local

CINEMA_TIMEZONE=Asia/Ho_Chi_Minh
DEMO_MODE=false
